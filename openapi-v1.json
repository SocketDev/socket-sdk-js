    "/v1/orgs/{org_slug}/threat-campaigns/": {
      "get": {
        "summary": "List threat campaigns",
        "tags": ["threat-campaigns"],
        "description": "Returns a paginated list of supply chain attack campaigns. Supports filtering\nby status, ecosystem, and an incremental sync parameter (`updated_after`).\n\nPackage PURLs are not inlined on the campaign object — they are their own\npaginated resource. Fetch them per campaign from\n`/threat-campaigns/:campaign_id/packages`.\n\nAuthentication: Organization API token, OAuth2, or NextAuth session.\nRequired token scope: `threat-campaigns:list`.\n\nThis endpoint requires an Enterprise Plan with the Threat Feed add-on.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": ["ongoing", "past"]
            },
            "in": "query",
            "name": "status",
            "required": false,
            "description": "Filter by campaign status. Defaults to ongoing."
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "ecosystem",
            "required": false,
            "description": "Filter by ecosystem (e.g. npm, pypi, maven)."
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "updated_after",
            "required": false,
            "description": "Unix timestamp in seconds. Only return campaigns updated after this time. Omit to return all matching campaigns."
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "in": "query",
            "name": "per_page",
            "required": false,
            "description": "Number of campaigns per page. Default 30, max 100."
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "cursor",
            "required": false,
            "description": "Opaque cursor for pagination. Use the endCursor value from the previous response."
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "org_slug",
            "required": true,
            "description": "Organization slug"
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "required": ["items"],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true,
                        "required": [
                          "id",
                          "name",
                          "description",
                          "status",
                          "ecosystem",
                          "firstDiscovered",
                          "lastActivity",
                          "blogUrls",
                          "linkedThreatCount",
                          "linkedPackageArtifactsCount",
                          "htmlUrl",
                          "createdAt",
                          "updatedAt"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string",
                            "enum": ["ongoing", "past"]
                          },
                          "ecosystem": {
                            "type": ["null", "array"],
                            "items": {
                              "type": "string"
                            }
                          },
                          "firstDiscovered": {
                            "type": ["null", "string"]
                          },
                          "lastActivity": {
                            "type": ["null", "string"]
                          },
                          "blogUrls": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "linkedThreatCount": {
                            "type": "integer",

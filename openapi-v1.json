    "/v1/orgs/{org_slug}/threat-campaigns/{campaign_id}/packages": {
      "get": {
        "summary": "List packages for a threat campaign",
        "tags": ["threat-campaigns"],
        "description": "Returns a cursor-paginated list of package PURLs affected by a single supply\nchain attack campaign. This is the primary way to retrieve all packages for a\nknown campaign without an inline, unbounded list on the campaign object.\n\nPagination follows the same `{ items, endCursor }` envelope as the campaigns\nlist. Pass the `endCursor` value back as `cursor` to fetch the next page.\n\nAuthentication: Organization API token, OAuth2, or NextAuth session.\nRequired token scope: `threat-campaigns:list`.\n\nThis endpoint requires an Enterprise Plan with the Threat Feed add-on.",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "in": "query",

    "/v1/orgs/{org_slug}/purl/versions/{purl}": {
      "get": {
        "summary": "List published versions for a package by PURL",
        "tags": ["packages"],
        "description": "Given a package URL (PURL) *without* a version, returns every version\nSocket knows about for that package along with its publish date, sorted\nnewest-first by publish date.\n\nThis lets you enforce version policies such as \"N-1\" (allow the previous\nrelease, block the newest) without querying a package registry directly.\nVersions with no known publish date are listed last.\n\n**Ordering includes prereleases.** Sorting is by publish date only, so\nindex 0 is the most recently *published* version, not necessarily the\nnewest stable release. On npm in particular the newest publishes are\noften canaries or release candidates, so a consumer that reads index 1\nas \"N-1\" can land on a prerelease. Each entry carries a `prerelease`\nflag for this: filter out entries where `prerelease` is `true` before\napplying an N-1 rule. `prerelease` is `null` when the ecosystem's\nversion grammar has no canonical prerelease parser, or when the version\nstring itself does not parse — treat null according to your own policy\nrather than as an error.\n\nPass `limit` to cap how many entries come back; it is applied after\nsorting, so `limit=2` is all the N-1 use case needs. A `limit` that\nis not a positive integer is rejected with a 400 rather than clamped.\n\nThe PURL must be percent-encoded as a single path segment\n(`encodeURIComponent`); an unencoded `/` will not match this route.\nAny version on the PURL is ignored — the full history always comes back.\nThe HuggingFace `type` qualifier (model, dataset, or space) is honored.\n\nA well-formed PURL for an ecosystem that does not support version\nlisting returns a 400 rather than a server error.\n\nAuthentication: Organization API token, OAuth2, or NextAuth session.\nRequired token scope: `packages:list`. Costs 100 quota units.",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "in": "query",
            "name": "limit",
            "required": false,
            "description": "Maximum number of version entries to return, applied after sorting. Omit for the full history."
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "org_slug",
            "required": true,
            "description": "Organization slug"
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "purl",
            "required": true,
            "description": "Package URL, percent-encoded as a single path segment. Example: pkg%3Anpm%2F%40babel%2Fcore"
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["purl", "versions"],
                  "properties": {
                    "purl": {
                      "type": "string",
                      "description": "The PURL as received, echoed back."
                    },
                    "versions": {
                      "type": "array",
                      "description": "Known versions, newest-first by publish date. Ordering includes prereleases, so index 0 is the most recent publish rather than the newest stable release.",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["version", "publishedAt", "prerelease"],
                        "properties": {
                          "version": {
                            "type": "string",
                            "description": "The version string as the ecosystem reports it."
                          },
                          "publishedAt": {
                            "type": ["null", "string"],
                            "description": "ISO-8601 publish date, or null when the ecosystem reports none. Undated versions are listed last."
                          },
                          "prerelease": {
                            "type": ["null", "boolean"],
                            "description": "True when this version is a prerelease (canary, release candidate, dev, beta) according to the ecosystem's own version grammar. Null means unknown — either the ecosystem has no canonical prerelease parser, or this version string does not parse. Null is not an error."
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "statusCode": {
                      "type": "number"
                    },
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": ["statusCode", "error", "message"]
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "statusCode": {
                      "type": "number"
                    },
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": ["statusCode", "error", "message"]
                }
              }
            }
          },
          "403": {

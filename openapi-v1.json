                    }
                  },
                  "required": ["statusCode", "error", "message"]
                }
              }
            }
          },
          "404": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "statusCode": {
                      "type": "number"
                    },

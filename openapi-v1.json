            "description": "Number of packages per page. Default 100, max 1000."
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "cursor",
            "required": false,
            "description": "Opaque cursor for pagination. Use the endCursor value from the previous response."

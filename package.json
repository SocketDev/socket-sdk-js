  "typeCoverage": {
    "atLeast": 99,
    "cache": true,
    "ignore-files": "test/*",
    "ignore-non-null-assertion": true,
    "ignore-type-assertion": true,
    "ignoreAsAssertion": true,
    "ignoreCatch": true,
    "ignoreEmptyType": true,
    "strict": true
  },
  "devEngines": {
    "packageManager": [
      {
        "name": "npm",
        "version": "^11.19.0 || >=12.0.2",
        "onFail": "error"
      },
      {
        "name": "pnpm",
        "version": "^11.25.0 || >=12.3.4",
        "onFail": "error"
      }
    ]
  },
  "engines": {
    "node": ">=24",
    "npm": "^11.19.0 || >=12.0.2",
    "pnpm": "^11.25.0 || >=12.3.4"
  },
  "allowScripts": {
    "cpu-features": false,
    "protobufjs": false,
    "puppeteer": false,
    "rolldown": true,
    "ssh2": false

{
  "name": "@socketsecurity/sdk",
  "version": "4.3.0",
  "description": "SDK for the Socket API client",
  "homepage": "https://github.com/SocketDev/socket-sdk-js",
  "license": "MIT",
  "author": {
    "name": "Socket Inc",
    "email": "eng@socket.dev",
    "url": "https://socket.dev"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/SocketDev/socket-sdk-js.git"
  },
  "files": [
    "CHANGELOG.md",
    "data/*.json",
    "dist/*.d.mts",
    "dist/types/*.d.mts",
    "dist/utils/*.d.mts",
    "dist/*.js",
    "dist/external/*",
    "types/*.d.ts"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "source": "./src/index.mts",
      "types": "./dist/index.d.mts",
      "browser": "./dist/index.browser.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "source": "./src/testing.mts",
      "types": "./dist/testing.d.mts",
      "default": "./dist/testing.js"
    },
    "./types/api": {
      "types": "./types/api.d.ts"
    },
    "./types/api-helpers": {
      "types": "./types/api-helpers.d.ts"
    },
    "./package.json": "./package.json",
    "./types/api-v1": {
      "types": "./types/api-v1.d.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "approve:npm": "node scripts/repo/npm/approve.mts",
    "build": "node scripts/repo/build.mts",
    "check": "pnpm run fmt:check && pnpm run lint && pnpm run repo:type && pnpm run build",
    "check:api-contracts": "node scripts/repo/check/api-contracts-are-current.mts",
    "check:package-artifact": "node scripts/repo/package-artifact-is-complete.mts",
    "check:quota-sync": "node scripts/repo/validate-quota-sync.mts",
    "clean": "node scripts/repo/clean.mts",
    "cover": "vitest run --coverage --config .config/repo/vitest.config.mts",
    "docs:api": "node scripts/repo/gen-api-docs.mts",
    "docs:api:check": "node scripts/repo/gen-api-docs.mts --check",
    "fix": "pnpm run fmt && oxlint --config .config/repo/oxlintrc.json --fix src test scripts/repo .config/repo && pnpm run fmt",
    "fmt": "oxfmt --config .config/repo/oxfmtrc.json --write .",
    "fmt:check": "oxfmt --config .config/repo/oxfmtrc.json --check .",
    "generate-sdk": "node scripts/repo/generate-sdk.mts",
    "lint": "oxlint --config .config/repo/oxlintrc.json src test scripts/repo .config/repo",
    "postpublish": "pnpm run clean",
    "prepublishOnly": "node -e \"if (process.env.GITHUB_ACTIONS !== 'true') throw new Error('Publish through the npm workflow')\"",
    "publish:npm": "node scripts/repo/npm/dispatch.mts",
    "repo:check": "pnpm run repo:type && pnpm run build",
    "repo:type": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config .config/repo/vitest.config.mts",
    "test:fuzz": "node scripts/repo/fuzz.mts",
    "type": "pnpm run repo:type",
    "update:openapi": "pnpm run generate-sdk && pnpm run docs:api"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "catalog:",
    "@babel/parser": "catalog:",
    "@babel/traverse": "catalog:",
    "@bcoe/v8-coverage": "catalog:",
    "@mdn/browser-compat-data": "catalog:",
    "@modelcontextprotocol/client": "catalog:",
    "@playwright/mcp": "catalog:",
    "@shadscan/cli": "catalog:",
    "@sinclair/typebox": "catalog:",
    "@socketregistry/packageurl-js": "1.7.0",
    "@socketregistry/packageurl-js-stable": "catalog:",
    "@socketsecurity/lib": "catalog:",
    "@socketsecurity/lib-stable": "catalog:",
    "@socketsecurity/registry-stable": "catalog:",
    "@socketsecurity/sdk": "catalog:",
    "@socketsecurity/sdk-stable": "catalog:",
    "@sveltejs/acorn-typescript": "catalog:",
    "@types/babel__traverse": "catalog:",
    "@types/mdast": "catalog:",
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "@types/shell-quote": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@ultrathink/acorn.rs.wasm": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "@vitiate/core": "catalog:",
    "acorn": "catalog:",
    "ast-v8-to-istanbul": "catalog:",
    "ata-validator": "catalog:",
    "c8": "catalog:",
    "chrome-devtools-mcp": "catalog:",
    "del": "catalog:",
    "ecc-agentshield": "catalog:",
    "fallow": "catalog:",
    "fast-check": "catalog:",
    "fast-glob": "catalog:",
    "form-data": "catalog:",
    "magic-string": "catalog:",
    "markdownlint-cli2": "catalog:",
    "mcp-tada": "catalog:",
    "mdast-util-from-markdown": "catalog:",
    "mdast-util-gfm": "catalog:",
    "mdast-util-to-markdown": "catalog:",
    "micromark": "catalog:",
    "micromark-extension-gfm": "catalog:",
    "neosanitize": "catalog:",
    "nock": "catalog:",
    "npm-high-impact": "catalog:",
    "openapi-typescript": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "parse5": "catalog:",
    "playwright-core": "catalog:",
    "portless": "catalog:",
    "regjsparser": "catalog:",
    "rolldown": "catalog:",
    "run-local-ci": "catalog:",
    "semver": "catalog:",
    "shell-quote": "catalog:",
    "svgo": "catalog:",
    "taze": "catalog:",
    "typebox": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vitiate": "catalog:",
    "yaml": "catalog:"
  },
  "typeCoverage": {
    "atLeast": 99,
    "cache": true,
    "ignore-files": "test/*",
    "ignore-non-null-assertion": true,
    "ignore-type-assertion": true,
    "ignoreAsAssertion": true,
    "ignoreCatch": true,
    "ignoreEmptyType": true,
    "strict": true
  },
  "devEngines": {
    "packageManager": [
      {
        "name": "npm",
        "version": ">=12.2.0",
        "onFail": "error"
      },
      {
        "name": "pnpm",
        "version": ">=12.12.0",
        "onFail": "error"
      }
    ]
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=12.2.0",
    "pnpm": ">=12.12.0"
  },
  "allowScripts": {
    "cpu-features": false,
    "protobufjs": false,
    "puppeteer": false,
    "rolldown": true,
    "ssh2": false
  },
  "npm-run-all2": {
    "nodeRun": true
  }
}

    "setup:1password": "node scripts/fleet/setup/one-password.mts",
    "setup:ci:local": "node scripts/fleet/ci/local/setup.mts",
    "setup:ci:remote": "node scripts/fleet/ci/remote/setup.mts",
    "setup:pgbot": "node scripts/fleet/setup/pgbot.mts",
    "mcp:pgbot": "node scripts/fleet/mcp/pgbot/run.mts",
    "mcp:schemas:check": "node scripts/fleet/mcp/schemas.mts check",
    "mcp:schemas:save": "node scripts/fleet/mcp/schemas.mts save",
    "sweep:worktrees": "node scripts/fleet/worktree-sweep.mts",

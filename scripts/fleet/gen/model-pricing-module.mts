#!/usr/bin/env node
/*
 * @file Renders `constants/model-pricing.generated.mts` from
 *   `constants/model-pricing.json`, inlining the data as a frozen module
 *   constant.
 *
 *   The point is the fleet-pack. A loose JSON read through `fs` at run time
 *   cannot be bundled: rolldown sees a path, not a value, so every consumer
 *   needs the file on disk in the right place and `loadPricing` throws when it
 *   is absent. A module constant is a value rolldown inlines, so the prices
 *   ride inside `fleet-pack.cjs` and every consumer works with no external
 *   file at all.
 *
 *   This step is DETERMINISTIC — JSON in, module out, no network. The network
 *   half stays in `update-model-pricing.mts`, the canonical writer the pricing
 *   skill drives, and the publish pipeline runs that first so the baked
 *   numbers are current at the moment the pack is cut. Splitting the two is
 *   what lets `generated-artifacts-are-current` gate this file: a
 *   regenerate-and-compare against a live fetch would fail on every real
 *   upstream price change.
 *
 *   Usage: node scripts/fleet/gen/model-pricing-module.mts
 */

import { existsSync, readFileSync } from 'node:fs'

import { getDefaultLogger } from '@socketsecurity/lib-stable/logger/default'

import { isMainModule } from '../process/is-main-module.mts'
import { writeThroughMirrorLock } from '../fs/mirror-lock.mts'
import { runMain } from '../process/run-main.mts'
import {
  MODEL_PRICING_JSON,
  MODEL_PRICING_MODULE,
  TEMPLATE_MODEL_PRICING_JSON,
  TEMPLATE_MODEL_PRICING_MODULE,
} from '../paths.mts'

import type { ScriptMeta } from '../process/run-main.mts'

const BANNER = [
  '/*',
  ' * @file GENERATED by scripts/fleet/gen/model-pricing-module.mts from',
  ' *   constants/model-pricing.json. Never hand-edit: the generator overwrites',
  ' *   it, and `generated-artifacts-are-current` fails on any difference.',
  ' *',
  ' *   The prices live here as a module constant so rolldown inlines them into',
  ' *   fleet-pack.cjs. Consumers read `loadPricing()` and need no file on disk.',
  ' *',
  ' *   To change a price, run the updating-pricing skill, which writes the JSON',
  ' *   through scripts/fleet/update-model-pricing.mts, then re-run this.',
  ' */',
].join('\n')

/**
 * The module source for `data`.
 *
 * The literal is emitted through `JSON.stringify` with two-space indent so the
 * output is stable byte for byte across runs, which is what makes the
 * freshness gate meaningful. The formatter reflows it afterwards.
 */
/**
 * Strip every `$comment*` key, at any depth.
 *
 * Those keys document the JSON for whoever edits it. They are not data, and
 * one of them sits INSIDE a `models` map, so carrying them over would force
 * the record type to admit a bare string beside every price. Dropping them
 * keeps the baked constant purely typed and the pack smaller.
 */
export function stripComments(value: unknown): unknown {
  if (Array.isArray(value)) {
    return value.map(v => stripComments(v))
  }
  if (value === null || typeof value !== 'object') {
    return value
  }
  const out: Record<string, unknown> = {}
  for (const [key, val] of Object.entries(value)) {
    if (key.startsWith('$comment')) {
      continue
    }
    out[key] = stripComments(val)
  }
  return out
}

export function renderPricingModule(data: unknown): string {
  const literal = JSON.stringify(data, undefined, 2)
    .split(/\r?\n/)
    .map(line => `  ${line}`)
    .join('\n')
  return [
    BANNER,
    '',
    "import type { PricingData } from '../estimate-ai-cost.mts'",
    '',
    'export const MODEL_PRICING: PricingData = Object.freeze<PricingData>(',
    `${literal},`,
    ')',
    '',
  ].join('\n')
}

/**
 * Both trees get their own copy, the same split `prebuild-dispatch-artifacts`
 * keeps: the LIVE module feeds this checkout, and the `template/base` one is
 * what the bundle walk ships. Neither is committed.
 */
export function pricingTrees(): ReadonlyArray<{
  json: string
  module: string
}> {
  return [
    { json: MODEL_PRICING_JSON, module: MODEL_PRICING_MODULE },
    {
      json: TEMPLATE_MODEL_PRICING_JSON,
      module: TEMPLATE_MODEL_PRICING_MODULE,
    },
  ]
}

/**
 * Render the pricing module into every tree from its JSON source.
 *
 * `build-hook-snapshot` calls this before rolldown runs, because the consumers
 * import the artifact statically and it is gitignored: without it a fresh clone
 * dies on UNRESOLVED_IMPORT rather than producing a pack.
 *
 * Always renders. The module is a pure function of the JSON, so re-rendering is
 * either a no-op or a correction. Skipping when the file happens to exist would
 * let a stale module outlive a price change, since nothing else re-derives it:
 * the fetcher rewrites only the JSON.
 *
 * Deterministic and network-free. The live-pricing fetch stays in
 * `update-model-pricing.mts`, which writes the JSON this reads.
 */
export function bakePricingModule(): number {
  let baked = 0
  const trees = pricingTrees()
  for (let i = 0, { length } = trees; i < length; i += 1) {
    const tree = trees[i]!
    if (!existsSync(tree.json)) {
      continue
    }
    const raw = readFileSync(tree.json, 'utf8')
    const data: unknown = stripComments(JSON.parse(raw))
    // The live copy is a cascade-locked mirror, chmod 0444, so a raw write
    // throws EACCES. Every generator writing into that tree goes through this
    // helper rather than lifting the lock by hand.
    writeThroughMirrorLock(tree.module, renderPricingModule(data))
    baked += 1
  }
  return baked
}

export function main(): number {
  const logger = getDefaultLogger()
  const baked = bakePricingModule()
  logger.log(`model-pricing.generated.mts: baked into ${baked} tree(s)`)
  return 0
}

const SCRIPT_META: ScriptMeta = {
  describe:
    'renders the model-pricing module the fleet-pack bundles, from the pricing JSON',
  help: 'Usage: node scripts/fleet/gen/model-pricing-module.mts',
}

if (isMainModule(import.meta.url)) {
  runMain(main, SCRIPT_META)
}
